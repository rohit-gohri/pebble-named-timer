{
  "name": "named-timers",
  "version": "1.0.0",
  "description": "Countdown timer for Pebble Time 2 and Pebble Round 2 with named timers, voice dictation, and phone settings sync.",
  "author": "Boring Downloads",
  "private": true,
  "keywords": [
    "pebble-app"
  ],
  "pebble": {
    "displayName": "Named Timers",
    "uuid": "bdae1e1e-2828-4e9b-9e6d-071ee568ed8f",
    "sdkVersion": "3",
    "projectType": "native",
    "enableMultiJS": true,
    "usesPermissions": [],
    "targetPlatforms": [
      "emery",
      "gabbro"
    ],
    "watchapp": {
      "onlyShownOnCommunication": false,
      "hiddenApp": false,
      "watchface": false
    },
    "capabilities": [
      "configurable"
    ],
    "messageKeys": [
      "PRESET_0",
      "PRESET_1",
      "PRESET_2",
      "PRESET_3",
      "PRESET_4",
      "PRESET_5",
      "PRESET_6",
      "PRESET_7",
      "TIMERS_DATA",
      "SYNC_REQUEST",
      "STATE_SYNC"
    ],
